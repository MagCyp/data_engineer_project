# Copy this file to .env before starting Docker Compose.
POSTGRES_DB=data_platform_dw
POSTGRES_USER=data_platform_user
POSTGRES_PASSWORD=change_me_for_local_development

# Use localhost from the host machine. Use postgres_db from another Compose service.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Optional: identifies the app and provides higher Socrata rate limits.
SOCRATA_APP_TOKEN=
