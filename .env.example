# Copy this file to .env before starting Docker Compose.
POSTGRES_DB=data_platform_dw
POSTGRES_USER=data_platform_user
POSTGRES_PASSWORD=change_me_for_local_development

# Use localhost from the host machine. Use postgres_db from another Compose service.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Optional: identifies the app and provides higher Socrata rate limits.
SOCRATA_APP_TOKEN=

AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me_for_local_airflow

AIRFLOW_UID=50000
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=change_me_for_local_airflow

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
AIRFLOW_API_SECRET_KEY=change_me_to_a_long_random_api_secret
AIRFLOW_API_JWT_SECRET=change_me_to_a_long_random_jwt_secret
